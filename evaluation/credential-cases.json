{
  "schema_version": 1,
  "description": "Synthetic policy regressions. Annotated values must be fully covered even with no model findings; negative cases must remain unchanged. These do not change the model-only benchmark.",
  "cases": [
    {
      "id": "json-password",
      "segments": [
        "{\"password\": \"",
        {
          "label": "secret",
          "text": "example words"
        },
        "\"}"
      ]
    },
    {
      "id": "json-api-key",
      "segments": [
        "{\"api_key\": \"",
        {
          "label": "secret",
          "text": "demo"
        },
        "\"}"
      ]
    },
    {
      "id": "quoted-yaml-key",
      "segments": [
        "'access_token': '",
        {
          "label": "secret",
          "text": "example words"
        },
        "'"
      ]
    },
    {
      "id": "json-escaped-quotes",
      "segments": [
        "{\"password\": \"",
        {
          "label": "secret",
          "text": "example \\\"quoted\\\" words"
        },
        "\"}"
      ]
    },
    {
      "id": "unclosed-double-quote",
      "segments": [
        "password=\"",
        {
          "label": "secret",
          "text": "example words"
        }
      ]
    },
    {
      "id": "unclosed-single-quote",
      "segments": [
        "secret='",
        {
          "label": "secret",
          "text": "example words"
        }
      ]
    },
    {
      "id": "trailing-escape",
      "segments": [
        "password=\"",
        {
          "label": "secret",
          "text": "example words\\"
        }
      ]
    },
    {
      "id": "unicode-short-assignment",
      "segments": [
        "😀 token=",
        {
          "label": "secret",
          "text": "demo"
        },
        "; next step"
      ]
    },
    {
      "id": "negative-reset-property",
      "segments": [
        "{\"password_reset\": true, \"secret_count\": 0}"
      ]
    },
    {
      "id": "negative-description",
      "segments": [
        "The password reset flow needs a clearer description."
      ]
    },
    {
      "id": "credential-multiline-quoted",
      "groups": [
        "credentials",
        "multiline"
      ],
      "segments": [
        "Synthetic password=\"",
        {
          "label": "secret",
          "text": "example first line\nexample second line"
        },
        "\"\nContinue investigating the login error."
      ]
    },
    {
      "id": "credential-yaml-literal",
      "groups": [
        "credentials",
        "multiline"
      ],
      "segments": [
        "Synthetic configuration:\npassword: |\n  ",
        {
          "label": "secret",
          "text": "example first line\n  example second line"
        },
        "\npublic_note: keep this explanation"
      ]
    },
    {
      "id": "credential-yaml-folded",
      "groups": [
        "credentials",
        "multiline"
      ],
      "segments": [
        "Synthetic configuration:\naccess_token: >-\n  ",
        {
          "label": "secret",
          "text": "example first line\n  example second line"
        },
        "\npublic_note: keep this explanation"
      ]
    },
    {
      "id": "nested-yaml-crlf",
      "segments": [
        "config:\r\n  password: |2- # synthetic\r\n    ",
        {
          "label": "secret",
          "text": "example first\r\n\r\n    example second"
        },
        "\r\n  public_note: keep this"
      ]
    },
    {
      "id": "folded-plus-yaml",
      "segments": [
        "'secret': >+2\n  ",
        {
          "label": "secret",
          "text": "example first\n    indented value\n  example last"
        },
        "\npublic_note: keep this"
      ]
    },
    {
      "id": "multiline-single-quote",
      "segments": [
        "😀 token='",
        {
          "label": "secret",
          "text": "example first\r\nexample second"
        },
        "'; public note"
      ]
    },
    {
      "id": "multiline-escaped-quote",
      "segments": [
        "password=\"",
        {
          "label": "secret",
          "text": "example \\\"quoted\\\" first\nexample second"
        },
        "\"; public note"
      ]
    }
  ]
}
