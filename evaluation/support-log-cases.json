{
  "schema_version": 1,
  "description": "Authored synthetic review-policy cases for copied HTTP headers and forwarded credentials. The model-only datasets are unchanged. All values are invented, never usable credentials.",
  "cases": [
    {
      "id": "http-authorization",
      "segments": [
        "Authorization: Bearer ",
        {
          "label": "secret",
          "text": "example words"
        },
        "\nPublic context: investigate error 404."
      ]
    },
    {
      "id": "http-proxy-authorization",
