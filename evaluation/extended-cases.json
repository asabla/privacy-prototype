{
  "schema_version": 1,
  "description": "Additional hand-labelled synthetic examples. Values and people are invented. Groups overlap and are not representative language or domain benchmarks. Multiline credential annotations include the whole value, not its key or quote delimiters.",
  "cases": [
    {"id": "sv-name-diacritics", "groups": ["swedish", "unicode"], "segments": ["Hej, jag heter ", {"label": "private_person", "text": "Åsa Lindström"}, ". Jag behöver hjälp med inloggningen."]},
    {"id": "sv-hyphenated-name", "groups": ["swedish", "unicode"], "segments": ["Mitt namn är ", {"label": "private_person", "text": "Anna-Lisa Öberg"}, "."]},
    {"id": "sv-street-address", "groups": ["swedish"], "segments": ["Min hemadress är ", {"label": "private_address", "text": "Exempelgatan 12, 123 45 Teststad"}, "."]},
    {"id": "sv-multiline-address", "groups": ["swedish", "multiline"], "segments": ["Skicka brevet till min bostad:\n", {"label": "private_address", "text": "Exempelgatan 12\n123 45 Teststad"}, "\nTack!"]},
    {"id": "sv-date-of-birth", "groups": ["swedish"], "segments": ["Mitt födelsedatum är ", {"label": "private_date", "text": "1980-03-14"}, "."]},
    {"id": "sv-private-phone", "groups": ["swedish"], "segments": ["Mitt privata telefonnummer är ", {"label": "private_phone", "text": "+46 70 123 45 67"}, "."]},
    {"id": "sv-synthetic-personnummer", "groups": ["swedish"], "segments": ["Exemplets påhittade personnummer är ", {"label": "account_number", "text": "19700101-0000"}, "."]},
    {"id": "sv-negative-company", "groups": ["swedish", "negative"], "segments": ["Exempelbolaget publicerar allmän information om sin nya tjänst."]},
    {"id": "forwarded-headers", "groups": ["forwarded"], "segments": ["Please help with this forwarded request.\n--- Forwarded message ---\nFrom: ", {"label": "private_person", "text": "Alice Smith"}, " <", {"label": "private_email", "text": "alice@example.com"}, ">\nTo: ", {"label": "private_person", "text": "Bob Jones"}, " <", {"label": "private_email", "text": "bob@example.com"}, ">\nSubject: Account access\nI cannot sign in."]},
    {"id": "forwarded-quoted-repetition", "groups": ["forwarded", "unicode"], "segments": ["😀 Reply to ", {"label": "private_email", "text": "asa@example.com"}, ".\n> Earlier, ", {"label": "private_person", "text": "Åsa Lindström"}, " wrote:\n> Please contact ", {"label": "private_email", "text": "asa@example.com"}, "."]},
    {"id": "forwarded-signature", "groups": ["forwarded", "multiline"], "segments": ["> Regards,\n> ", {"label": "private_person", "text": "Alice Smith"}, "\n> Private phone: ", {"label": "private_phone", "text": "+1 (415) 555-0137"}, "\n> Home: ", {"label": "private_address", "text": "123 Example Street"}]},
    {"id": "forwarded-negative-release", "groups": ["forwarded", "negative"], "segments": ["--- Forwarded public announcement ---\n> The public release date is 2026-04-22.\n> All users can read the release notes."]},
    {"id": "credential-json-quoted-key", "groups": ["credentials"], "segments": ["Synthetic diagnostic: {\"password\": \"", {"label": "secret", "text": "example words"}, "\"}"]},
    {"id": "credential-json-escaped-quote", "groups": ["credentials"], "segments": ["Synthetic diagnostic: {\"password\": \"", {"label": "secret", "text": "example \\\"quoted\\\" words"}, "\"}"]},
    {"id": "credential-multiline-quoted", "groups": ["credentials", "multiline"], "segments": ["Synthetic password=\"", {"label": "secret", "text": "example first line\nexample second line"}, "\"\nContinue investigating the login error."]},
    {"id": "credential-yaml-literal", "groups": ["credentials", "multiline"], "segments": ["Synthetic configuration:\npassword: |\n  ", {"label": "secret", "text": "example first line\n  example second line"}, "\npublic_note: keep this explanation"]},
    {"id": "credential-yaml-folded", "groups": ["credentials", "multiline"], "segments": ["Synthetic configuration:\naccess_token: >-\n  ", {"label": "secret", "text": "example first line\n  example second line"}, "\npublic_note: keep this explanation"]},
    {"id": "credential-unfinished-quote", "groups": ["credentials"], "segments": ["Synthetic token='", {"label": "secret", "text": "example unfinished words"}]},
    {"id": "credential-negative-fields", "groups": ["credentials", "negative"], "segments": ["{\"password_reset\": true, \"secret_count\": 0, \"token_count\": 12}"]},
    {"id": "credential-negative-instructions", "groups": ["credentials", "negative"], "segments": ["Please reset the password. Never paste your access token into the ticket."]},
    {"id": "unicode-combining-name", "groups": ["unicode"], "segments": ["My name is ", {"label": "private_person", "text": "Zoë Åberg"}, "."]},
    {"id": "unicode-adjacent-emoji", "groups": ["unicode", "boundaries"], "segments": ["👩🏽‍💻", {"label": "private_email", "text": "alice@example.com"}, "👨‍👩‍👧‍👦"]},
    {"id": "boundary-plus-address", "groups": ["boundaries"], "segments": ["Contact <", {"label": "private_email", "text": "alice+support@example.com"}, ">; do not include the brackets."]},
    {"id": "boundary-private-url", "groups": ["boundaries"], "segments": ["My confidential patient record is (", {"label": "private_url", "text": "https://example.org/patient/alice/report"}, ")."]},
    {"id": "boundary-short-account", "groups": ["boundaries"], "segments": ["My bank account number is ", {"label": "account_number", "text": "123456789012"}, "; please remove it."]},
    {"id": "negative-product-names", "groups": ["negative"], "segments": ["Quarterly Revenue Report and Product Support Portal are fictional product names."]},
    {"id": "negative-software-version", "groups": ["negative"], "segments": ["The software version is 3.14.7 and the status code is 404."]},
    {"id": "negative-public-date-swedish", "groups": ["swedish", "negative"], "segments": ["Det offentliga lanseringsdatumet är 2026-04-22."]}
  ]
}
